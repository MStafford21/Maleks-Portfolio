@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600&display=swap");

/* Reset & General Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
    text-decoration: none;
    scroll-behavior: smooth;
}

body {
    width: 100%;
    height: auto;
    background-color: rgb(44, 42, 39);
    overflow-x: hidden;
}

/* Scrollbar Customization */
::-webkit-scrollbar {
    width: 10px;
}

::-webkit-scrollbar-track {
    background: rgb(44, 42, 39);
}

::-webkit-scrollbar-thumb {
    background-color: #b74b4b;
    border-radius: 12px;
    transition: all 0.3s ease;
}

::-webkit-scrollbar-thumb:hover {
    background-color: #b74b4b;
}

/* Navigation Styles */
nav {
    width: 100%;
    height: 10vh;
}

.nav-container {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: space-around;
    align-items: center;
}

.logo {
    color:white;
    font-size: 2rem;
    font-weight: bold;
}

.logo span {
    color:#b74b4b;
    text-shadow: 0 0 10px #b74b4b;
}

/* Dropdown settings */
.dropdown {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  background: rgba(0, 0, 0, 0.85);
  transform: translateY(-100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.3s ease, opacity 0.3s ease;
  z-index: 999;
}

.dropdown.active {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.dropdown .links {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30px 0;
}

.dropdown .links a {
  color: white;
  padding: 15px 0;
  font-size: 1.2rem;
  width: 100%;
  text-align: center;
  text-decoration: none;
}

.dropdown .links a:hover {
  background-color: #b74b4b;
  color: white;
}

 .cancel {
  display: none;
}

/* Responsive menu for mobile */
@media (max-width: 968px) {
  .nav-container .links {
    display: none;
  }

  .hamburg {
    display: block;
    font-size: 2rem;
    color: white;
    cursor: pointer;
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 1001;
  }

 .cancel {
     display: block;
    font-size: 2rem;
    color: white;
    cursor: pointer;
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 1001;
  }
}

/* Navigation Links */
.nav-container .links {
    display: flex;
}

.nav-container .links a {
    position: relative;
    font-size: 1.2rem;
    color:white;
    margin: 0 20px;
    text-decoration: none;
    font-weight: 550;
    transition: 0.3s linear;
}

.nav-container .links a::before {
    position: absolute;
    content: "";
    bottom: -3px;
    left: 0;
    width: 0%;
    height: 3px;
    background-color:#b74b4b;
    transition: 0.2s linear;
}

.nav-container .links a:hover::before {
    width: 100%;
}

.nav-container .links a:hover {
    color: #b74b4b;
}

/* Dropdown Menu */
.dropdown {
    z-index: 100;
    position: absolute;
    top: 0;
    transform: translateY(-500px);
    width: 100%;
    height: auto;
    backdrop-filter: blur(4px) brightness(40%);
    box-shadow: 0 0 20px black;
    transition: 0.2s linear;
}

.dropdown .links a {
    display: flex;
    color: white;
    text-decoration: none;
    justify-content: center;
    padding: 15px 0;
    align-items: center;
    transition: 0.2s linear;
}

.dropdown .links a:hover {
    background-color: #b74b4b;
}

/* Section Styles */
section {
    width: 100%;
    min-height: 90vh;
}

footer {
    background: #b74b4b;
    padding: 15px 0;
    text-align: center;
    font-family: 'Poppin' sans-serif;
}

footer .text span {
    font-size: 17px;
    font-weight: 400;
    color: wheat;
}

footer .text span a {
    font-weight: 500;
    color: white;
}

footer .text span a:hover {
    text-decoration: underline;
}

.scroll-button a {
    position: fixed;
    bottom: 20px;
    right: 20px;
    color: rgb(44, 42, 39);
    background: #b74b4b;
    padding: 7px 12px;
    font-size: 18px;
    border-radius: 6px;
    box-shadow: black;
    display: none;
}

@media (max-width:968px){
    nav .logo{
        position:absolute;
        top:16px;
        left:15px;
        font-size:1.5rem;
    }
    section .main-container{
        padding-left:0px;
        display:flex;
        flex-direction:column;
    }
    .nav-container .links{
        display:none;
    }
    .hamburg,
    .cancel{
        opacity:1;
        pointer-events:visible;
    }

}
